<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diff_bot">
    
    <!--======== Base Link (Robot Chasis) ========-->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.155" rpy="0 0 0"/> <!-- chasis height centre= 0.75 and ground clearance= 0.8=diameter of castor wheel-->
            <geometry>
                <box size="0.5 0.3 0.15"/>                
            </geometry>
            <material name="blue">
                <color rgba="0.2 0.2 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.155" rpy="0 0 0"/>
            <geometry>
                <box size="0.5 0.3 0.15"/>                
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.155" rpy="0 0 0"/>
            <mass value="5.0"/>
            <inertia ixx="0.047" ixy="0.0" ixz="0.0" iyy="0.11" iyz="0.0" izz="0.13"/>
        </inertial>        
    </link>


    <!-- ======== LEft Wheel ========-->
    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.08" length="0.04"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        
        <collision>
            <geometry>
                <cylinder radius="0.08" length="0.04"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.5"/>
            <inertia ixx="0.00086" ixy="0" ixz="0" iyy="0.00086" iyz="0" izz="0.0016"/>
        </inertial>
    </link> 

    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="-0.1 0.175 0.08" rpy="-1.5708 0 0"/> <!-- wheel sits 10cm behind chasis centre in x-axis, 17.5cm to left on y-axis (0.15 width from centre of chasis + 0.02 wheel width from wheel centre + 0.005 clearance b/w body and wheel) and wheel radius of 0.08 or 8cm -->
        <axis xyz="0 0 1"/>
    </joint>


    <!-- ======== Right Wheel ========-->
    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.08" length="0.04"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        
        <collision>
            <geometry>
                <cylinder radius="0.08" length="0.04"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.5"/>
            <inertia ixx="0.00086" ixy="0" ixz="0" iyy="0.00086" iyz="0" izz="0.0016"/>
        </inertial>
    </link> 

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="-0.1 -0.175 0.08" rpy="-1.5708 0 0"/> <!-- wheel sits 10cm behind chasis centre in x-axis, 17.5cm to right on y-axis (0.15 width from centre of chasis + 0.02 wheel width from wheel centre + 0.005 clearance b/w body and wheel) -->
        <axis xyz="0 0 1"/>
    </joint>
    

    <!-- ======= Front Castor Wheel ========-->
    <link name="castor_wheel">
        <visual>
            <geometry>
                <sphere radius="0.04"/>
            </geometry>
            <material name="white">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>
        
        <collision>
            <geometry>
                <sphere radius="0.04"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.2"/>
            <inertia ixx="0.000128" ixy="0" ixz="0" iyy="0.000128" iyz="0" izz="0.000128"/>
        </inertial>
    </link>

    <joint name="castor_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="castor_wheel"/>
        <origin xyz="0.15 0 0.04" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>


    <!-- ======= Gazebo Differential Drive Plugin ======= -->
    <gazebo>
        <plugin name="gz::sim::systems::DiffDrive" filename="libgz-sim-diff-drive-system.so">
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>0.35</wheel_separation>
            <wheel_radius>0.08</wheel_radius>
            <odom_publish_frequency>30</odom_publish_frequency>
            <topic>cmd_vel</topic>
            <odom_topic>odom</odom_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
        </plugin>
    </gazebo>



    <!-- === Make caster wheel frictionless so it glides smoothly === -->
    <gazebo reference="castor_wheel">
        <mu1>0.001</mu1>
        <mu2>0.001</mu2>
    </gazebo>
</robot>